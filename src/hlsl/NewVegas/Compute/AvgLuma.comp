// AvgLuma as a compute reduction (needs NVR DXVK): Effects/AvgLuma.fx.hlsl's pass with the exact average of every pixel.
// Phase 0: one partial sum of the linear BT.709 luminance per 16 x 16 tile. Phase 1 (one group): the total, then the pass's
// per-frame logic (smoothing, adaptation, focus), written to the state buffer that C++ copies into TESR_AvgLumaBuffer.
// The state layout is shared with AvgLumaHistogram.comp: 32 bytes: vec4 cur (newLuma, animatedLuma, focus, 1), two uints
// (cur packed as four half floats: the texel's bytes at offset 16), float average (offset 24), float share (offset 28).
// effects/AvgLuma.cpp RenderCompute fills the push block (128 bytes).
#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_samplerless_texture_functions : enable
#include "Common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform texture2D t_color;		// TESR_RenderedBuffer
layout(set = 1, binding = 1) uniform texture2D t_depth;		// TESR_DepthBuffer (CombineDepth's output)
layout(std430, set = 1, binding = 2) buffer Partials { float partial[]; };

struct State {
    vec4 cur;
    uvec2 packed;
    float average;
    float share;
};
layout(std430, set = 1, binding = 3) readonly buffer StateIn { State stateIn; };
layout(std430, set = 1, binding = 4) writeonly buffer StateOut { State stateOut; };

layout(push_constant) uniform Push {
    uint width;				// 0
    uint height;			// 4
    uint groupsX;			// 8
    uint groupsY;			// 12
    uint phase;				// 16: 0 tile sums, 1 total and the frame's logic
    uint samplerIndex;		// 20: LINEAR, CLAMP
    uint pad0;
    uint pad1;
    vec4 motionBlurData;	// 32
    vec4 depthOfFieldData;	// 48
    vec4 gameTime;			// 64: w frame time
    vec4 exposureData;		// 80: z dark adaptation, w light adaptation
    vec4 cameraData;		// 96: y far
    vec4 histogram;			// 112: unused here
} pc;

shared float sumTile[256];

// The twelve taps (the same as the D3D9 pass): a golden-angle spiral, offsets from the centre in screen units.
vec2 tapOffset(int i) {
    float angle = float(i) * 2.39996323;
    float radius = 0.5 * sqrt((float(i) + 0.5) / 12.0);
    return vec2(cos(angle), sin(angle)) * radius;
}

// Linear depth (game units) at a screen uv.
float depthAt(vec2 uv) {
    return textureLod(sampler2D(t_depth, NVR_SAMPLER(pc.samplerIndex)), uv, 0.0).x * pc.cameraData.y;
}

void main() {
    uint lid = gl_LocalInvocationIndex;

    if (pc.phase == 0u) {
        ivec2 p = ivec2(gl_GlobalInvocationID.xy);
        float v = 0.0;
        if (p.x < int(pc.width) && p.y < int(pc.height))
            v = luma(linearize(texelFetch(t_color, p, 0).rgb));
        sumTile[lid] = v;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1u) {
            if (lid < s) sumTile[lid] += sumTile[lid + s];
            barrier();
        }
        if (lid == 0u) partial[gl_WorkGroupID.y * pc.groupsX + gl_WorkGroupID.x] = sumTile[0];
        return;
    }

    // Phase 1: the total of the tile sums, the exact average, then the per-frame logic on one thread.
    uint tiles = pc.groupsX * pc.groupsY;
    float total = 0.0;
    for (uint i = lid; i < tiles; i += 256u) total += partial[i];
    sumTile[lid] = total;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lid < s) sumTile[lid] += sumTile[lid + s];
        barrier();
    }
    if (lid != 0u) return;

    float average = sumTile[0] / (float(pc.width) * float(pc.height));

    // Smoothing: one-eighth of the new average each frame.
    vec4 prev = stateIn.cur;
    float newLuma = (average + 7.0 * prev.x) / 8.0;

    // Adaptation: at most dt x DarkAdapt down and dt x LightAdapt up per frame.
    float dt = pc.gameTime.w;
    float delta = newLuma - prev.y;
    float animatedLuma = delta < 0.0 ?
        prev.y + max(delta, -dt * pc.exposureData.z) :
        prev.y + min(delta, dt * pc.exposureData.w);

    // Focus: the centre and twelve taps spread by the camera's rotation speed (a centre farther than the mean wins).
    vec2 speed = clamp(abs(pc.motionBlurData.xy), vec2(0.0), vec2(1.0)) + 0.1;
    float centreDepth = depthAt(vec2(0.5));
    float depthSum = centreDepth;
    for (int d = 0; d < 12; d++)
        depthSum += depthAt(vec2(0.5) + 0.3 * tapOffset(d) * speed);
    float meanDepth = depthSum / 12.0;
    float depth = centreDepth > meanDepth ? centreDepth : meanDepth;
    float hyperFocal = max(1.0e-7, pc.depthOfFieldData.x * 1000.0);
    depth = clamp(depth / hyperFocal, 0.0, 1.0);

    float step = pow(max(prev.z, depth), 0.1);
    float focusDelta = depth - prev.z;
    float focus = focusDelta < 0.0 ?
        prev.z + max(focusDelta, -3.0 * step * dt) :
        prev.z + min(focusDelta, step * dt);

    vec4 cur = vec4(newLuma, animatedLuma, focus, 1.0);
    stateOut.cur = cur;
    stateOut.packed = uvec2(packHalf2x16(cur.xy), packHalf2x16(cur.zw));
    stateOut.average = average;
    stateOut.share = 1.0;
}
